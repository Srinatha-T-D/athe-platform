# Postgres (RDS in prod, local docker-compose in dev)
DATABASE_URL=postgresql://athe:athe@localhost:5432/athe?schema=public

# Auth
JWT_SECRET=replace-with-a-long-random-string

# CORS - comma separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173,https://shop.athe.example.com,https://admin.athe.example.com

# AWS
AWS_REGION=ap-south-1
UPLOADS_BUCKET=athe-design-uploads-prod

PORT=4000
NODE_ENV=production
